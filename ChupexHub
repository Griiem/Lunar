local function spawnVFX(cf, type)
    local selected = (type == "Jump" and getgenv().SelectedVFX) or (type == "Spike" and getgenv().SelectedSpikeVFX)
    if not selected or selected == "None" then return end
    local original = ReplicatedStorage.Effects:FindFirstChild(type, true) and ReplicatedStorage.Effects[type]:FindFirstChild(selected) or ReplicatedStorage.Effects.NewEffects:FindFirstChild(selected)
    if original then
        local clone = original:Clone(); clone:SetAttribute("IsGeminiEffect", true)
        for _, obj in pairs(clone:GetDescendants()) do if obj:IsA("BasePart") then obj.Anchored = true end end
        if clone:IsA("Model") then clone:PivotTo(cf) else clone.CFrame = cf end
        clone.Parent = Workspace
        local sound = clone:FindFirstChild("SoundEffect")
        if sound then sound.Volume = getgenv().GlobalVolume sound:Play() end
        task.delay(1.5, function() if clone then clone:Destroy() end end)
    end
end

RunService.Heartbeat:Connect(function()
    local char = player.Character; local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    if Settings.WSAtivado then hum.WalkSpeed = Settings.WSValor end
    if Settings.JPAtivado and hum.JumpPower ~= 0 then hum.JumpPower = Settings.JPValor end

    -- Gravidade
    if Settings.GravAtivada then
        local velY = hrp.AssemblyLinearVelocity.Y
        if hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.Jumping then
            workspace.Gravity = (velY > 0.1) and Settings.GravPulo or Settings.GravQueda
        else workspace.Gravity = 196.2 end
    end

    -- Tilt Changer (Física Melhorada)
    local tiltObj = hrp:FindFirstChild("Tilt")
    if tiltObj then
        if not Settings.OriginalTilt.HasSaved then
            Settings.OriginalTilt.P, Settings.OriginalTilt.D, Settings.OriginalTilt.MaxTorque = tiltObj.P, tiltObj.D, tiltObj.MaxTorque
            Settings.OriginalTilt.HasSaved = true
        end
        if Settings.TiltActive and (hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.Jumping) then
            local radAngle = math.rad(Settings.TiltAngle * 25)
            local rot = UIS:IsKeyDown("W") and CFrame.Angles(-radAngle,0,0) or UIS:IsKeyDown("S") and CFrame.Angles(radAngle,0,0) or UIS:IsKeyDown("A") and CFrame.Angles(0,0,radAngle) or UIS:IsKeyDown("D") and CFrame.Angles(0,0,-radAngle)
            if rot then
                tiltObj.MaxTorque = Vector3.new(4e5, 4e5, 4e5); tiltObj.D, tiltObj.P = 500, 10000
                local _, y, _ = hrp.CFrame:ToOrientation()
                tiltObj.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, y, 0) * rot
            else tiltObj.MaxTorque = Settings.OriginalTilt.MaxTorque end
        else tiltObj.MaxTorque = Settings.OriginalTilt.MaxTorque end
    end
end)

