local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local function instaRejoin()
    local placeId = game.PlaceId
    local jobId = game.JobId

    -- Criamos as opções de teleporte para tentar voltar pro mesmo servidor
    local options = Instance.new("TeleportOptions")
    options.ServerInstanceId = jobId

    -- Tentativa principal (Async)
    local success, err = pcall(function()
        TeleportService:TeleportAsync(placeId, {LP}, options)
    end)

    -- Se falhar (ex: servidor cheio ou restrito), ele força o join em um servidor novo
    if not success then
        warn("Erro no Teleport: " .. tostring(err))
        TeleportService:Teleport(placeId, LP)
    end
end

instaRejoin()
