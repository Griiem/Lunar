-- Interceptador (Backpack Fix)
local function Intercept(child)
    if gameEffectNames[child.Name] and not child:GetAttribute("LunarVFX") then
        task.delay(0, function() 
            if child then child:Destroy() end 
        end)
    end
end
getgenv().Lunar_Workspace = Workspace.ChildAdded:Connect(Intercept)

local function MonitorChar(char)
    if getgenv().Lunar_Character then getgenv().Lunar_Character:Disconnect() end
    getgenv().Lunar_Character = char.ChildAdded:Connect(Intercept)
end

-- Spawn do Efeito
local function spawnEffectAtPosition(pos)
    if configs.selectedEffect == "None" or not pos then return end

    local success, effectTemplate = pcall(function()
        return ReplicatedStorage.Effects.Jump[configs.selectedEffect]
    end)

    if not success or not effectTemplate then return end

    local clone = effectTemplate:Clone()
    clone:SetAttribute("LunarVFX", true)
    clone.Parent = Workspace
    
    local finalPos = pos - Vector3.new(0, configs.yOffset, 0)

    if clone:IsA("Model") then
        clone:PivotTo(CFrame.new(finalPos))
    elseif clone:IsA("BasePart") then
        clone.CFrame = CFrame.new(finalPos)
    end

    for _, v in pairs(clone:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Anchored = true
            v.CanCollide = false
        end
        if v:IsA("ParticleEmitter") then
            v.Enabled = true
            v.Emit(v, 20)
        end
    end

    local soundTemplate = sfxMap[configs.selectedEffect]
    if soundTemplate then
        local soundClone = soundTemplate:Clone()
        soundClone.Parent = clone
        soundClone:Play()
    end

    Debris:AddItem(clone, configs.lifeTime)
end

local function getGroundPosition()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local lFoot = char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg")
    local rFoot = char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")
    local root = char:FindFirstChild("HumanoidRootPart")

    if not root then return nil end
    if not lFoot then lFoot = root end
    if not rFoot then rFoot = root end
    
    local centerPos = (lFoot.Position + rFoot.Position) / 2
    local rayOrigin = centerPos + Vector3.new(0, 2, 0) 
    
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {char}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local rayResult = Workspace:Raycast(rayOrigin, Vector3.new(0, -15, 0), rayParams)
    
    return rayResult and rayResult.Position or (centerPos - Vector3.new(0, 2.5, 0))
end

-- Detector Físico
local function SetupJumpDetection(char)
    local humanoid = char:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    if getgenv().Lunar_JumpConn then getgenv().Lunar_JumpConn:Disconnect() end

    getgenv().Lunar_JumpConn = humanoid.StateChanged:Connect(function(oldState, newState)
        if newState == Enum.HumanoidStateType.Jumping then
            if isJumpCooldown then return end
            if configs.selectedEffect == "None" then return end
            
            isJumpCooldown = true
            task.delay(configs.cooldownTime, function() isJumpCooldown = false end)

            local jumpOrigin = getGroundPosition()
            
            task.spawn(function()
                task.wait(configs.delayTime) 
                if jumpOrigin then spawnEffectAtPosition(jumpOrigin) end
            end)
        end
    end)
    MonitorChar(char)
end

if LocalPlayer.Character then SetupJumpDetection(LocalPlayer.Character) end
getgenv().Lunar_CharAdded = LocalPlayer.CharacterAdded:Connect(SetupJumpDetection)


