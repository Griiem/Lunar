-- LÓGICA DO POP (N) E TECLAS (Z,X,C, E/T)
UserInputService.InputBegan:Connect(function(key, proc)
    if proc or not _G.ScriptRunning then return end
    
    if not isPopActive then
        if key.KeyCode == Enum.KeyCode.E then currentPwr = math.min(currentPwr + 1, 15.5)
        elseif key.KeyCode == Enum.KeyCode.T then currentPwr = math.max(currentPwr - 1, 0)
        elseif key.KeyCode == Enum.KeyCode.Z then currentPwr = 2
        elseif key.KeyCode == Enum.KeyCode.X then currentPwr = 6
        elseif key.KeyCode == Enum.KeyCode.C then currentPwr = 15.5 end
        updateDisplay()
    end

    -- POP COM CONTADOR AMARELO E COOLDOWN
    if key.KeyCode == Enum.KeyCode.N and not isPopActive and not isPopCooldown then
        isPopActive = true
        updateDisplay()
        status.TextColor3 = Color3.new(1, 1, 0) -- Amarelo
        
        task.spawn(function()
            for i = 7, 0, -1 do
                if not _G.ScriptRunning then break end
                status.Text = "SPEC STATUS: USING ("..i.."s)"
                task.wait(1)
            end
            
            isPopActive = false
            isPopCooldown = true
            updateDisplay()
            status.TextColor3 = Color3.new(1, 0, 0) -- Vermelho
            
            for i = 180, 1, -1 do
                if not _G.ScriptRunning then break end
                status.Text = "SPEC STATUS: COOLDOWN ("..i.."s)"
                task.wait(1)
            end
            
            if _G.ScriptRunning then
                status.Text = "SPEC STATUS: READY"
                status.TextColor3 = Color3.fromRGB(0, 255, 0) -- Verde
                isPopCooldown = false
            end
        end)
    end
end)


