local FakeSpec = "Higgie"
local currentPwr = 15.5
local isPopActive = false
local isPopCooldown = false

-- Função de Limpeza Definitiva (Visual)
local function ForceVisuals(v)
    if not v:IsA("TextLabel") or (v.Parent and v.Parent.Name == "TuffFinalHUD") then return end
    
    local function UpdateText()
        if not _G.ScriptRunning then return end
        local txt = v.Text:upper()
        
        -- Limpa Physical e Technical
        if txt == "HEAVY HITTER" or txt == "WIPER" or v.Name:find("Physical") or v.Name:find("Technical") then
            v.Text = ""
        end
        
        -- Troca NONE
        if _G.VisualActive and (txt == "NONE" or txt == "NENHUM") then
            v.Text = FakeSpec
        end
    end

    v:GetPropertyChangedSignal("Text"):Connect(UpdateText)
    UpdateText()
    
    -- Esconde Spike PWR original
    if v.Name:lower():find("pwr") or v.Text:find("/") then v.Visible = false end
end

game.Players.LocalPlayer.PlayerGui.DescendantAdded:Connect(ForceVisuals)
for _, v in pairs(game.Players.LocalPlayer.PlayerGui:GetDescendants()) do ForceVisuals(v) end

